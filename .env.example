# Copiá este archivo con el nombre ".env" y completá los valores reales.
# El archivo ".env" NO se sube a Git. Este ejemplo no lleva valores reales.

# 1 solo en tu PC de desarrollo. En producción debe estar en 0 o ausente.
DJANGO_DEBUG=1

# Obligatoria en producción. Generá una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# En desarrollo, si la dejás vacía, se genera una aleatoria en cada arranque.
DJANGO_SECRET_KEY=

# Dominios permitidos, separados por comas (producción). Ejemplo: operaciones.onrender.com
DJANGO_ALLOWED_HOSTS=
